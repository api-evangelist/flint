        {
          "id": "2057a891-1881-4362-9d20-3c95f2905016",
          "name": "Get task status",
          "request": {
            "name": "Get task status",
            "description": {
              "content": "Retrieve the status of a previously created agent task. While running, returns status only. On completion, returns an output object listing the pages created, modified, and deleted. On failure, returns an errorMessage.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "agent",
                "tasks",
                ":taskId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "taskId",
                  "description": "(Required) The task identifier returned by createAgentTask."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "8b2a5f13-891b-48fa-baff-be3632fc0ec2",
              "name": "Task status.",
              "originalRequest": {
