  "item": [
    {
      "id": "b35afcd0-86bb-4fbf-83da-b47f3026c3c9",
      "name": "Agent Tasks",
      "description": {
        "content": "Start and monitor background AI agent tasks on a Flint site.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b74f9e39-65cd-41a6-9922-8bc40ab86fac",
          "name": "Create an agent task",
          "request": {
            "name": "Create an agent task",
            "description": {
              "content": "Start a background AI agent on a Flint site. Two task types are supported: a free-form `prompt` task that instructs the agent to modify the site, and a `generate_pages` task that creates multiple pages from a template page and a list of items. Returns a taskId to poll or a callbackUrl is invoked on completion.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "agent",
                "tasks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"siteId\": \"<string>\",\n  \"prompt\": \"<string>\",\n  \"command\": \"prompt\",\n  \"callbackUrl\": \"<uri>\",\n  \"publish\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "e83e13cc-9b2f-422b-9c11-3e9a7a909333",
